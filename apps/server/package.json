{
  "name": "@beatbattle/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "auth generate --config src/auth/schema.cli.ts --adapter drizzle --dialect sqlite --output src/db/auth-schema.ts --yes && node scripts/auth-schema-post.mjs",
    "build": "vite build --config build.config.mjs && node scripts/smoke-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@beatbattle/emails": "workspace:^",
    "@beatbattle/shared": "workspace:^",
    "@libsql/client": "0.18.0",
    "better-auth": "1.7.7",
    "cloudinary": "2.11.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "nodemailer": "10.0.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
