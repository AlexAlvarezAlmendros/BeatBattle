# Entorno del servidor de BeatBattle (apps/server). Guía §4.15.
#
#   cp apps/server/.env.example apps/server/.env
#
# `pnpm dev:server` y `pnpm dev:all` lo cargan solos (--env-file-if-exists). Una variable vacía
# (`VAR=`) cuenta como no definida. Nunca subas el .env al repo (lo bloquea el hook guard-secrets).
# Los valores de abajo son los de desarrollo local; en Vercel se definen en el panel del proyecto.
#
# Cada bloque indica en qué fase empieza a usarse. Hasta entonces el servidor no la lee ni la valida
# (src/config/env.ts valida solo las de la Fase 0).

# ──────────────────────────────────────────────────────────────────────────────
# Servidor · Fase 0
# ──────────────────────────────────────────────────────────────────────────────
# development | test | production. En Vercel se fuerza production (api/index.ts).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent. El registro nunca lleva cookies,
# cabeceras de autorización, cuerpos, consultas de la URL ni IP.
LOG_LEVEL=info
# 1 detrás de un proxy (Vercel, Caddy): la IP real sale de X-Forwarded-For.
TRUST_PROXY=0

# URL pública de la web, sin barra final. Obligatoria en producción
# (https://battle.otherpeople.es). Su origen se permite siempre en ALLOWED_ORIGINS y será la
# baseURL de Better Auth (Fase 2). En las previews de Vercel, si no se define, se usa
# https://$VERCEL_BRANCH_URL (la URL de la rama).
BB_PUBLIC_URL=http://localhost:5173
# Orígenes extra permitidos en escrituras (POST/PUT/PATCH/DELETE), separados por comas, como
# esquema://host[:puerto] sin ruta. Un Origin ajeno o ausente → 403 FORBIDDEN_ORIGIN.
# Sin definir: http://localhost:5173 fuera de producción; en producción, solo el de BB_PUBLIC_URL.
# En las previews de Vercel (VERCEL_ENV=preview) se añaden solos https://$VERCEL_BRANCH_URL y
# https://$VERCEL_URL, que cambian en cada rama y despliegue (src/serverless.ts). Requiere tener
# expuestas las variables de sistema de Vercel (opción por defecto del proyecto; revisar en Fase 10).
ALLOWED_ORIGINS=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# Base de datos (libSQL) · Fase 0
# ──────────────────────────────────────────────────────────────────────────────
# Local: fichero (se crea ./data/ si no existe) o sqld del docker-compose (http://127.0.0.1:8080).
# Producción: Turso en la UE (libsql://<bd>-<org>.turso.io) con su token.
# Las migraciones se aplican al arrancar.
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=
# Carpeta de migraciones si no es la de por defecto. Solo hace falta en Vercel: dentro de la función
# la de por defecto es apps/server/drizzle (relativa a su directorio de trabajo, incluida con
# vercel.json → includeFiles). Vacía = la de por defecto.
MIGRATIONS_DIR=

# ──────────────────────────────────────────────────────────────────────────────
# Reloj de prueba · Fase 0 (guía §4.12)
# ──────────────────────────────────────────────────────────────────────────────
# 1 activa la cabecera x-bb-test-now (ms Unix o ISO 8601 con zona) para fijar la hora de cada
# petición en tests y E2E. Con NODE_ENV=production el servidor NO ARRANCA si está a 1.
BB_TEST_CLOCK=0

# ──────────────────────────────────────────────────────────────────────────────
# Cuentas (Better Auth) · Fase 2 (guía §4.9)
# ──────────────────────────────────────────────────────────────────────────────
# Secreto de firma de sesiones y tokens (≥ 32 caracteres): openssl rand -base64 48
BETTER_AUTH_SECRET=
# OAuth de Google y Discord. URL de retorno: <BB_PUBLIC_URL>/api/auth/callback/<proveedor>.
# Crear las apps de OAuth requiere confirmación del usuario (CLAUDE.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Email · Fase 2 (guía §4.19)
# ──────────────────────────────────────────────────────────────────────────────
# Solo local: transporte SMTP contra Mailpit (`pnpm mail:dev`, sin Docker, o `docker compose up -d`;
# bandeja en http://localhost:8025). Ningún email sale de la máquina. Vacía en producción y preview.
SMTP_URL=smtp://127.0.0.1:1025
# Producción y preview: una dirección del Google Workspace de otherpeople.es propia de Beat Battle
# (no la de la tienda del sello), con verificación en dos pasos y contraseña de aplicación.
# TLS verificado contra smtp.gmail.com:465 (guía §4.19.1).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Remitente (mismos nombres que el sello): la propia dirección del Workspace (EMAIL_FROM_ADDRESS = GMAIL_USER).
EMAIL_FROM_NAME="Beat Battle · Other People"
EMAIL_FROM_ADDRESS=beatbattle@localhost
# Buzón real del sello que recibe las respuestas.
MAIL_REPLY_TO=
# Cupo en ventana móvil de 24 h (1900 con el Workspace; 450 con un Gmail normal); 25 % para servicio.
MAIL_DAILY_LIMIT=1900
# Clave HMAC de los enlaces de baja en un clic (≥ 32 caracteres): openssl rand -base64 48
UNSUBSCRIBE_SECRET=
# Previews de Vercel y desarrollo local con Gmail: los únicos destinatarios permitidos (direcciones o
# @dominio, separados por comas). Sin lista no sale ningún email: ni la preview ni tu máquina envían a
# direcciones reales (guía §4.19.1, tarea 2.28). En local, pon aquí tu propio email para probar.
MAIL_PREVIEW_ALLOWLIST=

# ──────────────────────────────────────────────────────────────────────────────
# Almacenamiento de audio (Cloudinary) · Fase 1 (spike) y desde la Fase 3 (guía §4.8)
# ──────────────────────────────────────────────────────────────────────────────
# Mismas variables que el sello, con una cuenta propia de BeatBattle (decisión del 2026-10-07, guía §4.8.1).
# Las tres juntas o ninguna; sin ellas, /dev/escucha (spike 1.7) avisa de que faltan.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Prefijo de carpetas por entorno: beatbattle (solo producción), beatbattle-dev en local,
# beatbattle-preview-<pr> en las previews. Fuera de producción, «beatbattle» impide arrancar (RF-STO-06).
BB_CLOUDINARY_PREFIX=beatbattle-dev

# ──────────────────────────────────────────────────────────────────────────────
# Tareas programadas · Fase 3 (guía §4.12)
# ──────────────────────────────────────────────────────────────────────────────
# Secreto de /api/cron/tick (Vercel Cron y el flujo programado de GitHub Actions).
CRON_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Privacidad y antiabuso · Fase 3 (alertas sin cuenta) y Fase 5 (escuchas, señales) (guía §2.13, §4.13, §4.14)
# ──────────────────────────────────────────────────────────────────────────────
# Sal del hash de IP: límite de 3/h por IP de POST /api/subscribe (alerta de drop sin cuenta,
# Fase 3), escuchas públicas y señales de voto anómalo (Fase 5). Rotatoria (7 días); nunca se
# guarda una IP en claro. openssl rand -base64 32
IP_HASH_SALT=

# ──────────────────────────────────────────────────────────────────────────────
# Integración con Other People · Fase 9 (guía §2.16)
# ──────────────────────────────────────────────────────────────────────────────
# Orígenes del sello con CORS en /api/public/otp/summary, separados por comas.
OTP_ORIGINS=https://otherpeople.es
# API de la newsletter del sello (alta opcional desde el registro).
OTP_NEWSLETTER_API=

# ──────────────────────────────────────────────────────────────────────────────
# Observabilidad · opcional (guía §4.16)
# ──────────────────────────────────────────────────────────────────────────────
# Sentry sin PII. Vacía = desactivado.
SENTRY_DSN=
